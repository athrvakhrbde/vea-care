{
  "name": "vea-care",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "shopify:auth": "shopify store auth --store xshhuw-wx.myshopify.com --scopes read_products,write_products,read_orders,read_inventory",
    "shopify:info": "shopify store info --store xshhuw-wx.myshopify.com",
    "shopify:products": "shopify store execute --store xshhuw-wx.myshopify.com --query \"query { products(first: 20) { edges { node { title handle status variants(first: 5) { edges { node { id title price availableForSale } } } } } } }\"",
    "shopify:sync": "node scripts/shopify-sync-products.mjs"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
